# Deny everything, then allow only what the Dockerfile copies. .envrc, .env*, pb_data/, .git/,
# tests/, skills/, and any new file stay out of the build context unless they are listed here.
*
!POCKETCONTEXT_VERSION
!pocketcontext.json
!pb_migrations/*.js
!pb_hooks/*.js
!docker/entrypoint.py
!docker/litestream.yml
!ui/
ui/**
!ui/package.json
!ui/pnpm-lock.yaml
!ui/index.html
!ui/tsconfig.json
!ui/vite.config.ts
!ui/src/
!ui/src/**

# Demo runtime: supervisor, reset library, contact service, legal drafts and the
# public launcher used only to identify the tested client revision.
!legal/terms.html
!legal/privacy.html
!legal/legal.css
!deploy/demo/retention.py
!deploy/demo/contact_replica.py
!deploy/demo/contact-litestream.yml
!deploy/demo/once_runtime.py
!deploy/demo/reset.py
!skills/wikicontext/wikicontext
